# Base de datos Turso (https://turso.tech) — sincroniza entre dispositivos
# y guarda la suscripción a notificaciones push.
#
#   turso db create nutritrack
#   turso db show nutritrack --url
#   turso db tokens create nutritrack
#
# En Vercel: Project → Settings → Environment Variables

TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui

# Gemini API (Google AI Studio) para reconocer comidas desde foto.
# Capa gratuita generosa: 15 req/min y 1500/día con gemini-1.5-flash.
# Consigue tu key gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu-gemini-api-key

# VAPID keys para Web Push (https://datatracker.ietf.org/doc/html/rfc8292)
# Genera las tuyas con:  npx web-push generate-vapid-keys
# La pública se envía al cliente, la privada solo al servidor.
# VAPID_SUBJECT es un mailto: o https:// URL de contacto.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# (Opcional) protege el endpoint de cron si quieres.
# Cuando se define, /api/cron/reminders rechaza requests sin este valor
# en el header `x-cron-secret`.
CRON_SECRET=

# Huawei Health Kit OAuth 2.0 (Huawei Watch GT 2 Pro)
# Consigue tus credenciales en https://developer.huawei.com (AppGallery Connect)
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
HUAWEI_REDIRECT_URI=http://localhost:4321/api/huawei/callback

