# Base de datos Turso (https://turso.tech) — necesaria para sincronizar
# entre dispositivos. Sin estas variables la app funciona en modo local.
#
#   1. Crea una base de datos:  turso db create nutritrack
#   2. Obtén la URL:            turso db show nutritrack --url
#   3. Crea un token:           turso db tokens create nutritrack
#
# En Vercel: Project → Settings → Environment Variables

TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui
